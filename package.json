{
  "name": "agentic-editor",
  "private": true,
  "version": "0.1.0",
  "description": "Agentic local video editor framework (Remotion kit + schemas)",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "pnpm -r run build",
    "studio": "pnpm --filter @agentic-editor/remotion-kit studio",
    "render": "pnpm --filter @agentic-editor/remotion-kit render"
  },
  "engines": {
    "node": ">=20"
  }
}
